{
  "name": "archive-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write '*.html' '*.js' src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/language-server": "^0.16.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript/lib-dom": "npm:@types/web",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@zip.js/zip.js": "^2.24.0",
    "content-disposition": "^3.0.0",
    "tailwindcss": "^4.3.5"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "printWidth": 120
        }
      }
    ],
    "tailwindStylesheet": "./src/style.css",
    "importOrder": [
      "^@",
      "<THIRD_PARTY_MODULES>",
      "^src/",
      "^[./]"
    ],
    "importOrderSortSpecifiers": true,
    "plugins": [
      "prettier-plugin-tailwindcss",
      "@trivago/prettier-plugin-sort-imports"
    ]
  }
}
